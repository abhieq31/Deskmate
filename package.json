{
  "name": "deskmate",
  "version": "1.1.0",
  "description": "Chess with the person at the next desk: one laptop, two laptops with one short code, or the computer.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:abhieq31/Deskmate",
  "scripts": {
    "start": "python3 -m http.server 8080 || npx --yes serve -l 8080 .",
    "typecheck": "tsc -p .",
    "build:js": "esbuild src/app.ts --bundle --format=esm --target=es2022 --charset=utf8 --legal-comments=inline --outfile=js/app.js",
    "build:css": "sass src/styles/style.scss css/style.css --no-source-map --style=expanded",
    "build": "npm run build:js && npm run build:css && node scripts/build-single.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "sass": "^1.93.2",
    "typescript": "^5.9.3"
  }
}
